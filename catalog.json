    "l": 1
   },
   {
    "t": "Народні соціально-побутові пісні",
    "p": 11,
    "l": 1
   },
   {
    "t": "Козацькі пісні",
    "p": 12,
    "l": 1
   },
   {
    "t": "Ой на г;орі та женці жнуть",
    "p": 14,
    "l": 1
   },
   {
    "t": "Чумацькі пісні",
    "p": 16,
    "l": 1
   },
   {
    "t": "Чум;аче, чумаче, чого зажурився?",
